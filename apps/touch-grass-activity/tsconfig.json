{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/client/**/*.ts",
    "src/shared/**/*.ts",
    "vite.config.ts",
    "tests/client-dom.test.ts",
    "tests/high-scores-ui.test.ts",
    "tests/look.test.ts",
    "tests/solo-ui.test.ts",
    "tests/chess-ui.test.ts"
  ]
}
